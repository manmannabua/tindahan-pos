# Copy to .env for local development. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://pos:pos@localhost:5432/pos

# Real Redis (docker compose up redis) ...
REDIS_URL=redis://localhost:6379/0
# ... or, on a machine without Redis, an in-process fake (development only):
# REDIS_URL=fakeredis://
# ...and run background jobs in-process instead of via Celery:
# BACKGROUND_JOBS_INLINE=true

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Local http://localhost development needs non-secure cookies.
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
ALLOW_SIGNUP=true
